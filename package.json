{
  "name": "NoPayStation-to-pkgiPSP",
  "version": "1.0.0",
  "description": "A CLI to convert no-paystation tsv files to .txt that pkgipsp needs",
  "license": "MIT",
  "author": "wirob",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs",
    "build:sea": "npm run bundle && node --build-sea sea-config.json",
    "start": "node --import=tsx src/index.ts",
    "test": "node --import=tsx --test src/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "esbuild": "^0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "csv": "^6.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
