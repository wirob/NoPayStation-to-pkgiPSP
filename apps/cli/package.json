{
  "name": "cli",
  "version": "1.0.0",
  "private": true,
  "description": "A CLI to convert no-paystation tsv files to .txt that pkgipsp needs",
  "license": "MIT",
  "author": "wirob",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs",
    "build:sea": "npm run bundle && mkdir sea && node --build-sea sea-config.json",
    "start": "node --import=tsx src/index.ts",
    "test": "node --import=tsx --test src/**/*.test.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "csv": "^6.6.3"
  }
}
